# =============================================
# voice-patient-registration — .env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env to version control.
# Variables defined in docs/05-env-and-secrets.md
# =============================================

# ------------------------------------
# Database (required)
# Use asyncpg driver scheme for async SQLAlchemy.
# For Supabase: copy URI from Settings > Database > Connection string
# Switch postgresql:// to postgresql+asyncpg://
# For production use port 6543 (Transaction Pooler) to avoid connection limit.
# ------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/patients_dev

# ------------------------------------
# Vapi webhook secret (required)
# Get from Vapi dashboard after creating the assistant.
# Used to validate that inbound tool-call requests come from Vapi.
# ------------------------------------
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# ------------------------------------
# Application environment (required)
# Values: development | production
# Controls debug mode and logging verbosity.
# ------------------------------------
ENVIRONMENT=development

# ------------------------------------
# Logging (optional, default: INFO)
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ------------------------------------
LOG_LEVEL=DEBUG

# ------------------------------------
# CORS allowed origins (optional)
# Comma-separated list of allowed origins for future dashboard.
# Example: https://dashboard.vapi.ai,https://myapp.onrender.com
# ------------------------------------
ALLOWED_ORIGINS=
